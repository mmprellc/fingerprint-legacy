# Stripe — use a restricted key (rk_test_...) in test mode.
# Checkout, files, and webhooks run in mock mode when these are unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Printful — orders are mocked when this is unset.
# Create the order against a catalog variant (poster / framed poster).
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
PRINTFUL_VARIANT_ARCHIVAL=
PRINTFUL_VARIANT_FRAMED=

# Public origin Printful can fetch print files from (required for live Printful).
PUBLIC_BASE_URL=

# Optional email via Resend. Without it, delivery is recorded on the order.
RESEND_API_KEY=
EMAIL_FROM=

# Owner dashboard. If unset, the prototype password is dev-legacy
# and the login page shows it so you can click through.
DASHBOARD_PASSWORD=

# Signs dashboard cookies and download links. Change this in production.
APP_SECRET=
