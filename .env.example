# Copy to .env.local for development. On Vercel, set these in
# Project → Settings → Environment Variables for Production.
# Never commit real values. Run `npm run production-check` before going live.

# Neon or Vercel Postgres. Use the pooled connection string on Vercel
# (the host contains "-pooler"). Vercel Postgres also injects POSTGRES_URL;
# DATABASE_URL wins when both are set. Unset locally, orders stay in data/.
DATABASE_URL=

# Generated portraits. Set one store, not both. Blob wins when both are set.
# Vercel → Storage → Blob connects BLOB_READ_WRITE_TOKEN for you.
BLOB_READ_WRITE_TOKEN=
# S3 or any S3-compatible store (Cloudflare R2, for example).
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional. Required for R2 and other non-AWS endpoints.
S3_ENDPOINT=
# Set to 1 for path-style endpoints (some MinIO and R2 setups).
S3_FORCE_PATH_STYLE=

# Stripe live mode. Prefer a restricted key (rk_live_…) over a secret key.
# Hosted Checkout does not embed the publishable key; it must still match
# the secret key's mode. Unset locally, checkout is the built-in test page.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret from the live webhook endpoint (whsec_…).
# Endpoint: https://YOUR_DOMAIN/api/webhooks/stripe
# Events: checkout.session.completed,
#         checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed
STRIPE_WEBHOOK_SECRET=

# Printful. Without PRINTFUL_API_KEY, development records a mock print.
# Production records an error instead of pretending a print shipped.
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
PRINTFUL_VARIANT_ARCHIVAL=
PRINTFUL_VARIANT_FRAMED=

# Canonical site origin, no trailing slash. Email links and Printful's
# fallback file URL use it. Example: https://fingerprintlegacy.com
PUBLIC_BASE_URL=

# Optional email via Resend. Without both, the note is stored on the order
# and the files are on the confirmation page.
RESEND_API_KEY=
EMAIL_FROM=

# Required in production and on any Vercel deploy. There is no default.
DASHBOARD_PASSWORD=

# Signs the dashboard cookie and download tokens. At least 24 characters.
# openssl rand -hex 32
APP_SECRET=
