# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe test mode. Use a restricted key (rk_test_...) when you can.
# Leave blank to run the built-in mock checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Printful. Leave blank to record a mock order after payment.
# Variant IDs default to enhanced matte posters and black frames.
# PRINTFUL_AUTO_CONFIRM=false leaves a draft instead of submitting it.
PRINTFUL_API_KEY=
PRINTFUL_AUTO_CONFIRM=true
# PRINTFUL_VARIANT_ARCHIVAL_8X10=4463
# PRINTFUL_VARIANT_FRAMED_8X10=4651

# Owner dashboard. In development the password is legacy-demo until this is set.
DASHBOARD_SECRET=

# Optional email for digital orders. Without it, the note is saved on the order.
RESEND_API_KEY=
EMAIL_FROM=
